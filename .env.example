# =============================================================================
# Real Estate CRM - Docker Environment Configuration
# =============================================================================
# Скопируйте этот файл как .env и настройте под свои нужды
# cp .env.example .env
#
# ВНИМАНИЕ: DB_NAME, DB_USER, DB_PASSWORD и SECRET_KEY — ОБЯЗАТЕЛЬНЫ.
# Контейнер НЕ запустится без этих переменных.

# =============================================================================
# Database (PostgreSQL) — ОБЯЗАТЕЛЬНО
# =============================================================================
DB_NAME=real_estate_crm
DB_USER=crm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_PORT=5432

# =============================================================================
# Backend Django
# =============================================================================
# Порт бэкенда (внешний)
BACKEND_PORT=8000

# Django settings — SECRET_KEY ОБЯЗАТЕЛЕН
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_c_from_django_core_management_utils_import_get_random_secret_key_print_get_random_secret_key

# Разрешённые хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.com

# URLs
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost

# =============================================================================
# Account Lockout (защита от брутфорса)
# =============================================================================
# Макс. неудачных попыток логина до блокировки
LOCKOUT_MAX_ATTEMPTS=10
# Время блокировки в секундах (300 = 5 минут)
LOCKOUT_DURATION=300

# =============================================================================
# Redis (кеширование и rate limiting)
# =============================================================================
# По умолчанию Redis доступен внутри Docker-сети, менять не нужно
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# Frontend
# =============================================================================
# Порт фронтенда (внешний)
FRONTEND_PORT=80

# API URL для фронтенда (относительный путь, т.к. nginx проксирует)
VITE_API_URL=/api
