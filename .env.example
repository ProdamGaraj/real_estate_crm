# =============================================================================
# Real Estate CRM - Docker Environment Configuration
# =============================================================================
# Скопируйте этот файл как .env и настройте под свои нужды
# cp .env.example .env
#
# ВНИМАНИЕ: DB_NAME, DB_USER, DB_PASSWORD и SECRET_KEY — ОБЯЗАТЕЛЬНЫ.
# Контейнер НЕ запустится без этих переменных.

# =============================================================================
# Database (PostgreSQL) — ОБЯЗАТЕЛЬНО
# =============================================================================
DB_NAME=real_estate_crm
DB_USER=crm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DB_PORT=5432

# =============================================================================
# Backend Django
# =============================================================================
# Порт бэкенда (внешний)
BACKEND_PORT=8000

# Django settings — SECRET_KEY ОБЯЗАТЕЛЕН
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_c_from_django_core_management_utils_import_get_random_secret_key_print_get_random_secret_key

# Разрешённые хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,your-domain.com

# URLs
SITE_URL=http://localhost:8000
FRONTEND_URL=http://localhost

# =============================================================================
# Account Lockout (защита от брутфорса)
# =============================================================================
# Макс. неудачных попыток логина до блокировки
LOCKOUT_MAX_ATTEMPTS=10
# Время блокировки в секундах (300 = 5 минут)
LOCKOUT_DURATION=300

# =============================================================================
# Redis (кеширование и rate limiting)
# =============================================================================
# По умолчанию Redis доступен внутри Docker-сети, менять не нужно
# REDIS_URL=redis://redis:6379/0

# =============================================================================
# Frontend
# =============================================================================
# Порт фронтенда (внешний)
FRONTEND_PORT=80

# API URL для фронтенда (относительный путь, т.к. nginx проксирует)
VITE_API_URL=/api

# =============================================================================
# Локализация
# =============================================================================
# Часовой пояс, в котором считаются «сегодня», просрочка платежей и дата оплаты
TIME_ZONE=Asia/Tashkent

# =============================================================================
# Почта (восстановление пароля)
# =============================================================================
# Пока EMAIL_HOST пуст, письма печатаются в консоль и до пользователя не доходят —
# самостоятельное восстановление пароля в этом режиме не работает
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@example.com

# =============================================================================
# Аутентификация
# =============================================================================
# Refresh-токен хранится в httpOnly-cookie. Значение True требует HTTPS:
# на площадке, работающей по http, выставьте False, иначе вход не сработает
# REFRESH_COOKIE_SECURE=True

# =============================================================================
# Доступ к документам
# =============================================================================
# Сколько секунд живёт ссылка на скан паспорта, договор или вложение
MEDIA_LINK_TTL=3600
# Отдавать файлы силами nginx (X-Accel-Redirect). По умолчанию включено вне DEBUG
# MEDIA_USE_ACCEL_REDIRECT=True

# =============================================================================
# Ограничение частоты запросов
# =============================================================================
# Лимиты разведены по назначению: вход защищаем жёстко, обычную работу — свободно.
# Попытки входа с одного IP (защита от перебора паролей)
# THROTTLE_LOGIN=5/min
# Всплеск запросов от одного пользователя: страховка от зациклившейся страницы
# THROTTLE_BURST=300/min
# Длительная нагрузка от одного пользователя за час работы
# THROTTLE_SUSTAINED=6000/hour
# Анонимные запросы вне партнёрского API. У партнёров лимит свой — из настроек
# их API-ключа (запросов в минуту и в день), общий предел на них не действует
# THROTTLE_ANON=100/hour
